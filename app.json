{
  "expo": {
    "name": "Todos Bien",
    "slug": "todos-bien",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "todosbien",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.renzoarroyo.todos-bien",
      "appleTeamId": "3S8A8U48YR",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.renzoarroyo.todosbien",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D6BC9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Todos Bien usa tu ubicación para registrar dónde estabas cuando ocurre un sismo, y mostrársela solo a los contactos que aceptaste.",
          "locationAlwaysAndWhenInUsePermission": "Todos Bien toma tu ubicación una sola vez, en el momento en que ocurre un sismo en tu zona, aunque la app esté cerrada. No te rastrea el resto del tiempo.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Todos Bien revisa tu agenda en el propio teléfono para encontrar quiénes ya usan la app. Los números se convierten en códigos irreversibles antes de salir del dispositivo; tu agenda nunca se sube."
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89758dc9-6d22-47fd-8dc7-2691d816f159"
      }
    }
  }
}
