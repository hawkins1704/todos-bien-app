{
  "expo": {
    "name": "Todos Bien",
    "slug": "todos-bien",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "todosbien",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "buildNumber": "3",
      "bundleIdentifier": "com.renzoarroyo.todos-bien",
      "appleTeamId": "3S8A8U48YR",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.renzoarroyo.todosbien",
      "adaptiveIcon": {
        "backgroundColor": "#0D6BC9",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D6BC9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Todos Bien toma tu ubicación una vez ahora, al dar el permiso, y después solo cuando hay un sismo en tu zona. Se la mostramos únicamente a los contactos que aceptaste, y no registramos tu recorrido.",
          "locationAlwaysAndWhenInUsePermission": "Todos Bien toma tu ubicación una vez ahora, al dar el permiso, y después solo cuando hay un sismo en tu zona, aunque la app esté cerrada. Así los contactos que aceptaste ven dónde estás en los minutos siguientes al sismo. No registramos tu recorrido ni guardamos un historial.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Todos Bien revisa tu agenda en el propio teléfono para encontrar quiénes ya usan la app. Los números se convierten en códigos irreversibles antes de salir del dispositivo; tu agenda nunca se sube."
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDqZkcCaQt18AFZqj0vcMEzrAjAdmuUgkw"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "89758dc9-6d22-47fd-8dc7-2691d816f159"
      }
    }
  }
}
