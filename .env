# Estas dos variables viajan dentro del bundle de la app (prefijo EXPO_PUBLIC_).
# No son secretos: la clave publishable está pensada para clientes públicos y toda la
# protección real vive en las políticas RLS de Postgres. Por eso el archivo se commitea,
# para que un clone limpio arranque sin pasos extra.
#
# Cualquier secreto de verdad (service_role, API keys de terceros) va en los secrets de
# Supabase Edge Functions o de EAS, NUNCA aquí.

EXPO_PUBLIC_SUPABASE_URL=https://gfutgfmiwzgjtcrinqwo.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e8OzOTEfFXx4XOqZKajzow_QQSW6KF2

# Largo del código de acceso por correo. Tiene que coincidir con
# Authentication > Providers > Email > "Email OTP Length" del dashboard de Supabase
# (acepta de 6 a 10). Si se omite, la app asume 8.
EXPO_PUBLIC_AUTH_CODE_LENGTH=8

# ---------------------------------------------------------------------------
# RevenueCat · SDK keys públicas (una por tienda)
#
# Son claves de cliente: RevenueCat las diseñó para viajar dentro del binario.
# La clave que SÍ es secreta es la "secret API key" (v2), que no se usa acá.
#
# ⚠️ `test_...` es la clave del Test Store de RevenueCat: sirve para probar el
# paywall sin tocar App Store Connect, pero NO cobra ni genera transacciones
# reales. Antes de cualquier build de TestFlight o producción hay que
# reemplazarla por la clave de la app de App Store, que empieza con `appl_`
# (RevenueCat → Project Settings → API keys → la app de iOS).
#
# ✅ Las dos claves de acá son las REALES de tienda (`appl_` y `goog_`), no la
# del Test Store. La de Android se agregó el 2026-09-03.
#
# ---------------------------------------------------------------------------
# NO HAY UN INTERRUPTOR DE «PRUEBA» A «PRODUCCIÓN». Estas dos claves son las
# mismas en sandbox y en producción, y no se cambian al publicar.
#
# Lo que decide el entorno es la COMPRA, no la configuración:
#
#   · iOS      · compra con un Apple ID de sandbox, o desde TestFlight
#                → recibo de sandbox
#              · compra desde la App Store publicada
#                → recibo de producción
#   · Android  · compra de una cuenta que sea «license tester» en Play Console,
#                o desde un track de prueba → compra de prueba, sin cobro
#              · compra desde Play publicada → cobro real
#
# RevenueCat lee de cuál se trata y etiqueta la transacción. En el panel se
# separan con el filtro Sandbox / Production. Lo único que hay que evitar es
# publicar con una clave `test_...`, que sí es otro entorno.
# ---------------------------------------------------------------------------
#
# Si la variable queda vacía, la app arranca igual: el botón de Premium se
# muestra deshabilitado en vez de abrir un paywall que no existe.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_JhBZbVKBeSgYlKtvuNIoDmIGbFQ
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_ggGEvILeolpugAwYXVnmxPmwapw

# Identificador del entitlement que otorga Premium, tal como está escrito en
# RevenueCat → Entitlements (el identifier, no el display name "Todos Bien
# Premium"). Si se omite, la app asume `premium`.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=Todos Bien Premium
